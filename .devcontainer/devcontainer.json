{
    "name": "salesbot",
    "image": "sales-bot:dev",
    "initializeCommand": "docker image inspect sales-bot:dev >/dev/null 2>&1 || docker build -t sales-bot:dev .",
    "customizations": {
        "vscode":{
            "extensions": [
                "ms-python.python",
                "ms-python.vs-code-pylance",
                "ms-azuretools.vscode-containers",
                "sst-dev.opencode"
            ],
            "settings": {
            "python.defaultInterpreterPath": "usr/local/bin/python"
            }
        }
    },
    "postCreateCommand": "curl -fsSL https://opencode.ai/install | bash"
}